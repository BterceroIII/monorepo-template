{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "backend",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
      "enabled": true,
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      }
    }
  },
  "instructions": [
    ".opencode/rules/ponytail.mdc",
    ".opencode/rules/shadcn-ui.mdc",
    ".opencode/rules/context-app.mdc",
    ".opencode/rules/prisma-best-practices.mdc"
  ],
  "skills": {
    "paths": [".agents/skills"]
  },
  "references": {
    "docs": {
      "path": "docs",
      "description": "Project documentation, requirements, and context files including CONTEXT_APP"
    }
  }
}
